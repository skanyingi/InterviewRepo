PORT=3000
WEB_ORIGIN=http://localhost:5173

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL must be: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ThriveVAS (https://app.thrivevas.com)
# THRIVEVAS_SENDER_ID = the sender ID/shortcode registered on your ThriveVAS account.
# Leave blank to let ThriveVAS use your account default.
THRIVEVAS_API_KEY=
THRIVEVAS_SENDER_ID=
THRIVEVAS_CALLBACK_URL=http://localhost:3000/api/sms/dlr
